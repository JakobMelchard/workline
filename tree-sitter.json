{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "workline",
      "camelcase": "Workline",
      "title": "workline",
      "scope": "source.workline",
      "path": ".",
      "file-types": ["workline", "wl"],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Text notation for strength sets, one exercise per line",
    "authors": [{ "name": "lilfeelz" }],
    "links": { "repository": "https://github.com/JakobMelchard/workline" }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "kotlin": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": true,
    "zig": false
  }
}
