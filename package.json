{
  "name": "@jakobmelchard/workline",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./vectors.json": "./test/vectors.json",
    "./workline.wasm": "./workline.wasm"
  },
  "files": [
    "lib",
    "types",
    "workline.wasm",
    "grammar.js",
    "src",
    "queries",
    "tree-sitter.json",
