    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tree-sitter generate && tree-sitter build --wasm -o workline.wasm",
    "prepare": "tsc -p tsconfig.build.json",
    "check": "tsc",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@jakobmelchard/config": "github:JakobMelchard/.config#v1.0.0",
    "@types/node": "^22",
    "typescript": "^5",
    "tree-sitter-cli": "0.27.0"
  },
  "dependencies": {
    "web-tree-sitter": "^0.27.0"
  },
  "allowScripts": {
    "tree-sitter-cli@0.27.0": true
  },
  "license": "MIT"
}
